# ---------------------------------------------------------------------------
# BENCHMARK DATA IS NOT REDISTRIBUTED. See DATA.md.
#
# These files hold verbatim third-party benchmark content -- full questions
# WITH answer keys. Two reasons they stay out of git:
#   1. OfficeQA (databricks/officeqa) is a GATED dataset. Republishing it
#      publicly would breach the terms accepted to download it.
#   2. Publishing an answer key for a live benchmark contaminates it: the
#      next generation of models trains on this repo.
# The prepare_*.py scripts ship, so anyone with access can rebuild them.
# ---------------------------------------------------------------------------
data/*.jsonl
data/*.json
data/officeqa_docs/
data/spreadsheetbench_verified_400/
data/spreadsheetbench_raw/
data/*.tar.gz
data/*.csv

# Live outputs -- regenerated by running the thing. The ARCHIVED record of the
# reported runs lives in record/ and IS tracked; these are the working dirs the
# kit writes into, so a local run never dirties the repo.
/results/
/vectors/
/logs/
/*.png

# Environments and caches -- rebuilt by setup.sh
.venv/
.agentvenv/
.plotvenv/
.hf_cache/
__pycache__/
*.pyc
.pytest_cache/

# Local scratch
*.swp
.DS_Store
